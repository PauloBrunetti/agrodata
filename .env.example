# Copie para .env e preencha com os dados do SEU MySQL. Nunca publique o .env.

# Opção 1 — URL única (padrão do Railway: use ${{MySQL.MYSQL_URL}})
# DATABASE_URL=mysql://usuario:senha@host:3306/agrodata

# Opção 2 — variáveis separadas
DB_HOST=localhost
DB_PORT=3306
DB_USER=agrodata_app
DB_PASSWORD=troque-esta-senha
DB_NAME=agrodata

# true para conexões que exigem TLS (ex.: MySQL gerenciado com IP público)
DB_SSL=false

# Porta HTTP da aplicação (o Railway define automaticamente)
PORT=3000

# Na primeira inicialização, cria tabelas + dados de demonstração se o banco estiver vazio
AUTO_INIT_DB=true

# Banco usado pelos testes automatizados (é APAGADO e recriado a cada `npm test`)
TEST_DB_NAME=agrodata_test
